# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://vetice:vetice123@localhost:5432/vetice_bnb?schema=public"

# JWT
JWT_ACCESS_SECRET="tu-secret-access-token-cambia-en-produccion"
JWT_REFRESH_SECRET="tu-secret-refresh-token-cambia-en-produccion"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# CORS (orígenes permitidos)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
